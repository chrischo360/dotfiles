[user]
    name = Christopher Cho
    email = ccho@wayfair.com

[core]
    editor = nvim
    autocrlf = input
    pager = delta
    excludesFile = ~/dotfiles/git/gitignore_global

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula
    plus-style = "syntax #2d4a3e"
    plus-emph-style = "syntax #3d6a4e"
    minus-style = "syntax #4a2d2d"
    minus-emph-style = "syntax #6a3d3d"
    line-numbers-plus-style = "#50fa7b"
    line-numbers-minus-style = "#ff5555"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "blue box"

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = log --graph --oneline --decorate --all
