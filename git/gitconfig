[user]
	email = ccho@wayfair.com
	name = Chris Cho
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[fetch]
	prune = true
[push]
	default = current