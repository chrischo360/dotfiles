.vscode
.idea
*.swp
*.swo

# macOS
.DS_Store

# Node modules (large and not needed for testing)
node_modules
*/node_modules

# Build artifacts
*.o
*.a
*.so

# Logs
*.log

# Cache directories
.cache
__pycache__

# Misc
.tmp
tmp/
