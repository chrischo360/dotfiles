{
  "version": 1,
  "shell": {
    "setup_complete": true
  },
  "theme_mode": "dark",
  "agent": {
    "model": "claude-opus-4-8-medium"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/cc446g/dotfiles/agent/hooks/notify.sh Devin"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(/**)",
      "Write(/**)",
      "exec",
      "Fetch(domain:docs.csnzoo.com)",
      "mcp__*"
    ],
    "deny": [
      "Exec(rm)",
      "Exec(sudo)",
      "Exec(chmod 777)",
      "Exec(chown)",
      "Exec(kill)",
      "Exec(killall)",
      "Exec(pkill)",
      "Exec(dd)",
      "Exec(mkfs)",
      "Exec(diskutil)",
      "Exec(shutdown)",
      "Exec(reboot)",
      "Exec(git push --force)",
      "Exec(git push --force-with-lease)",
      "Exec(git reset --hard)",
      "Exec(git clean)",
      "Write(**/.env)",
      "Write(.env)"
    ],
    "ask": [
      "mcp__bigquery__execute_sql",
      "mcp__pagerduty-mcp__create_incident",
      "mcp__pagerduty-mcp__manage_incidents",
      "mcp__pagerduty-mcp__add_responders",
      "mcp__pagerduty-mcp__add_note_to_incident",
      "mcp__pagerduty-mcp__start_incident_workflow",
      "mcp__pagerduty-mcp__create_alert_grouping_setting",
      "mcp__pagerduty-mcp__update_alert_grouping_setting",
      "mcp__pagerduty-mcp__delete_alert_grouping_setting",
      "mcp__pagerduty-mcp__create_service",
      "mcp__pagerduty-mcp__update_service",
      "mcp__pagerduty-mcp__create_team",
      "mcp__pagerduty-mcp__update_team",
      "mcp__pagerduty-mcp__delete_team",
      "mcp__pagerduty-mcp__add_team_member",
      "mcp__pagerduty-mcp__remove_team_member",
      "mcp__pagerduty-mcp__create_schedule",
      "mcp__pagerduty-mcp__create_schedule_override",
      "mcp__pagerduty-mcp__update_schedule",
      "mcp__pagerduty-mcp__update_event_orchestration_router",
      "mcp__pagerduty-mcp__append_event_orchestration_router_rule",
      "mcp__pagerduty-mcp__create_status_page_post",
      "mcp__pagerduty-mcp__create_status_page_post_update",
      "mcp__pagerduty-mcp__create_user"
    ]
  },
  "mcpServers": {
    "sequential-thinking": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y @modelcontextprotocol/server-sequential-thinking@latest"
      ]
    },
    "memory": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y @modelcontextprotocol/server-memory@latest"
      ]
    },
    "github": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server"
      ]
    },
    "atlassian": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "MCP_VERBOSE=true exec uvx mcp-atlassian --transport stdio"
      ]
    },
    "pagerduty-mcp": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec uvx pagerduty-mcp --enable-write-tools"
      ]
    },
    "buildkite": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec docker run -i --rm -e BUILDKITE_API_TOKEN ghcr.io/buildkite/buildkite-mcp-server stdio"
      ]
    },
    "glean_default": {
      "url": "https://wayfair-be.glean.com/mcp/default",
      "headers": {},
      "transport": "http"
    },
    "bigquery": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "BIGQUERY_PROJECT=$BIGQUERY_PROJECT exec npx -y @toolbox-sdk/server --prebuilt bigquery --stdio"
      ]
    },
    "sonarqube": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "SONARQUBE_URL=https://sonarqube-enterprise.service.csnzoo.com SONARQUBE_TOKEN='' SONARQUBE_USERNAME=${env:SONARQUBE_USERNAME} NODE_OPTIONS=--use-system-ca NODE_EXTRA_CA_CERTS=/Users/cc446g/.sonarqube-mcp/sonarqube-fullchain.pem exec npx -y sonarqube-mcp-server@latest"
      ]
    },
    "kubernetes": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y kubernetes-mcp-server@latest"
      ]
    },
    "kubernetes-dev": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "KUBECONFIG_DEV=${env:KUBECONFIG_DEV} exec ai-kit kube-mcp --env dev"
      ]
    },
    "kubernetes-prod": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "KUBECONFIG_PROD=${env:KUBECONFIG_PROD} exec ai-kit kube-mcp --env prod"
      ]
    },
    "sourcegraph": {
      "url": "https://wayfair.sourcegraphcloud.com/.api/mcp/v1",
      "headers": {
        "Authorization": "token ${env:SOURCEGRAPH_ACCESS_TOKEN}"
      },
      "transport": "http"
    },
    "terraform": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y terraform-mcp-server@latest"
      ]
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "transport": "http"
    },
    "fetch": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec docker run -i --rm mcp/fetch"
      ]
    },
    "context7": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y @upstash/context7-mcp"
      ]
    },
    "mcp-playwright": {
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec npx -y @playwright/mcp@latest"
      ]
    },
    "datadog": {
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
      "transport": "http"
    },
    "miro": {
      "url": "https://mcp.miro.com/",
      "transport": "http"
    }
  }
}
