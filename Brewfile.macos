# macOS-only Brewfile
# macOS-specific CLI tools, GUI apps, fonts
# All other CLI tools are managed by mise (.mise.toml)
# Install: brew bundle --file=~/dotfiles/Brewfile.macos

# ============================================
# CLI Tools (Not in mise registry or better via Homebrew)
# ============================================
brew "git"                 # Version control (not in mise)
brew "gh"                  # GitHub CLI (not in mise)
brew "git-delta"           # Better git diff (not in mise)
brew "neovim"              # Modern Vim (not in mise)

# ============================================
# macOS-Specific CLI Tools
# ============================================
brew "terminal-notifier"   # macOS notifications (macOS-only API)
brew "rsync"               # File sync (better than macOS default)
brew "curl"                # HTTP client (better than macOS default)
brew "swiftlint"           # Swift linter (macOS/iOS development)
brew "fancy-cat"           # Terminal PDF viewer using Ghostty/Kitty image protocol
brew "mpv"                 # Video player (works with yt-dlp)
brew "socat"               # Socket utility (for mpv IPC communication)
brew "fswatch"             # File system watcher (for outline-sync)

# ============================================
# Fonts
# ============================================
# Note: homebrew/cask-fonts tap is deprecated but fonts still work
cask "font-jetbrains-mono-nerd-font"
cask "font-caskaydia-cove-nerd-font"    # Cascadia Code with Nerd Font patches
cask "font-sauce-code-pro-nerd-font"    # Source Code Pro with Nerd Font patches

# ============================================
# GUI Applications
# ============================================
cask "aerospace"           # Tiling window manager
cask "docker-desktop"      # Container runtime with GUI
cask "claude-code"         # Claude AI CLI (GUI installer)
cask "chromium"            # Open-source browser
cask "ghostty"             # Modern GPU-accelerated terminal
cask "homerow"             # Keyboard navigation

# ============================================
# Optional Applications
# ============================================
# Uncomment if you want to install these

# cask "raycast"           # Launcher (requires manual setup)
# cask "alacritty"         # GPU-accelerated terminal
