# Environment Variables Template
# Copy this file to .env and fill in your actual values
# .env is gitignored and will not be committed

# GitHub
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Buildkite (for CI monitoring)
BUILDKITE_TOKEN=your_buildkite_api_token_here

# Glean (Wayfair search/knowledge base)
GLEAN_API_TOKEN=your_glean_api_token_here
GLEAN_INSTANCE=wayfair

# Git Configuration
GIT_AUTHOR_EMAIL=your.email@example.com
GIT_AUTHOR_NAME=Your Name

# Raycast Configuration
RAYCAST_AUTHOR=your_username

# Scout Browser Automation
# SCOUT_GITHUB_TOKEN=${GITHUB_TOKEN}  # Can reuse GitHub token

# Custom API Keys
# Add your own API keys below
