# Environment Variables Template
# Copy this file to .env and fill in your actual values
# .env is gitignored and will not be committed

# GitHub
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# AQUA_GITHUB_TOKEN is derived from GITHUB_TOKEN by install.sh (only when it
# looks like a real token), so you normally don't need to set it here.

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Buildkite (for CI monitoring)
BUILDKITE_TOKEN=your_buildkite_api_token_here

# Git identity is configured via git/gitconfig (and the includeIf block for
# ~/dotfiles), not via environment variables. Do not set GIT_AUTHOR_* here —
# exported GIT_AUTHOR_* would override per-repo git config everywhere.

# Sourcegraph Configuration
SRC_ENDPOINT=
SRC_ACCESS_TOKEN=
SOURCEGRAPH_TOKEN=

OUTLINE_API_TOKEN=
OPENAI_API_KEY=

# Datadog API key for Pi Datadog MCP
DD_API_KEY=
# Datadog application key for Pi Datadog MCP
DD_APPLICATION_KEY=
# Datadog MCP domain
DD_MCP_DOMAIN=mcp.datadoghq.com
# Datadog MCP toolsets to expose
DD_MCP_TOOLSETS=all
