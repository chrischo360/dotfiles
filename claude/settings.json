{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "BashOutput",
      "WebFetch",
      "WebSearch",
      "EnterPlanMode",
      "mcp__pal__clink"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/node_modules/**)",
      "Read(**/target/**)",
      "Read(**/.git/**)",
      "Read(**/build/**)",
      "Read(**/dist/**)",
      "Read(**/*.log)"
    ],
    "ask": [],
    "defaultMode": "default"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": []
      }
    ],
    "SessionEnd": [
      {
        "hooks": []
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/scripts/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/scripts/notify.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/scripts/track-agent.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "alwaysThinkingEnabled": false,
  "defaultMode": "plan",
  "allowedTools": [
    {
      "tool": "EnterPlanMode",
      "pathPattern": "**"
    },
    {
      "tool": "Read",
      "pathPattern": "**"
    },
    {
      "tool": "Write",
      "pathPattern": "**"
    },
    {
      "tool": "Edit",
      "pathPattern": "**"
    },
    {
      "tool": "Bash",
      "commandPattern": "ls*"
    },
    {
      "tool": "Bash",
      "commandPattern": "cd*"
    },
    {
      "tool": "Bash",
      "commandPattern": "pwd*"
    },
    {
      "tool": "Bash",
      "commandPattern": "cat*"
    },
    {
      "tool": "Bash",
      "commandPattern": "grep*"
    },
    {
      "tool": "Bash",
      "commandPattern": "echo*"
    },
    {
      "tool": "Bash",
      "commandPattern": "mkdir*"
    },
    {
      "tool": "Bash",
      "commandPattern": "touch*"
    },
    {
      "tool": "Bash",
      "commandPattern": "which*"
    },
    {
      "tool": "Bash",
      "commandPattern": "ps*"
    },
    {
      "tool": "Glob",
      "pathPattern": "**"
    },
    {
      "tool": "Grep",
      "pathPattern": "**"
    },
    {
      "tool": "BashOutput",
      "commandPattern": "*"
    },
    {
      "tool": "Task",
      "pathPattern": "*"
    },
    {
      "tool": "TodoWrite"
    },
    {
      "tool": "WebFetch",
      "urlPattern": "https://**"
    },
    {
      "tool": "mcp__pal__clink"
    }
  ],
  "allowedDirectories": [
    "~/dotfiles",
    "~/codebase",
    "~/codebase/basket-service",
    "~/codebase/block-builder-api",
    "~/codebase/block-builder-app",
    "~/codebase/CF-Cypress",
    "~/codebase/experience-decision-engine",
    "~/codebase/homebase",
    "~/codebase/homebase-design-tokens",
    "~/codebase/homebase-docs",
    "~/codebase/php",
    "~/codebase/sf-js-libraries",
    "~/codebase/sf-ui-cart-and-checkout",
    "~/codebase/sf-ui-checkout",
    "~/codebase/sf-ui-web",
    "~/codebase/terraform"
  ],
  "mcpServers": {}
}
