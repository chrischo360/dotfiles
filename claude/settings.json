{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/notify.sh SessionEnd"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/notify.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "defaultMode": "plan",
  "allowedTools": [
    {
      "tool": "Read",
      "pathPattern": "**"
    },
    {
      "tool": "Write",
      "pathPattern": "**"
    },
    {
      "tool": "Edit",
      "pathPattern": "**"
    },
    {
      "tool": "Bash",
      "commandPattern": "*"
    },
    {
      "tool": "Glob",
      "pathPattern": "**"
    },
    {
      "tool": "Grep",
      "pathPattern": "**"
    },
    {
      "tool": "BashOutput",
      "commandPattern": "*"
    },
    {
      "tool": "KillShell",
      "commandPattern": "*"
    },
    {
      "tool": "Task",
      "pathPattern": "*"
    },
    {
      "tool": "TodoWrite"
    },
    {
      "tool": "WebFetch",
      "urlPattern": "https://github.com/**"
    }
  ],
  "allowedDirectories": [
    "~/dotfiles",
    "~/codebase",
    "~/codebase/basket-service",
    "~/codebase/block-builder-api",
    "~/codebase/block-builder-app",
    "~/codebase/CF-Cypress",
    "~/codebase/experience-decision-engine",
    "~/codebase/homebase",
    "~/codebase/homebase-design-tokens",
    "~/codebase/homebase-docs",
    "~/codebase/php",
    "~/codebase/sf-js-libraries",
    "~/codebase/sf-ui-cart-and-checkout",
    "~/codebase/sf-ui-checkout",
    "~/codebase/sf-ui-web",
    "~/codebase/terraform"
  ]
}
