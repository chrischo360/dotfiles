{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "BashOutput",
      "WebFetch"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": []
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/scripts/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/scripts/notify.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": []
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "defaultMode": "plan",
  "allowedTools": [
    {
      "tool": "Read",
      "pathPattern": "**"
    },
    {
      "tool": "Write",
      "pathPattern": "**"
    },
    {
      "tool": "Edit",
      "pathPattern": "**"
    },
    {
      "tool": "Bash",
      "commandPattern": "ls*"
    },
    {
      "tool": "Bash",
      "commandPattern": "cd*"
    },
    {
      "tool": "Bash",
      "commandPattern": "pwd*"
    },
    {
      "tool": "Bash",
      "commandPattern": "cat*"
    },
    {
      "tool": "Bash",
      "commandPattern": "grep*"
    },
    {
      "tool": "Bash",
      "commandPattern": "echo*"
    },
    {
      "tool": "Bash",
      "commandPattern": "mkdir*"
    },
    {
      "tool": "Bash",
      "commandPattern": "touch*"
    },
    {
      "tool": "Bash",
      "commandPattern": "which*"
    },
    {
      "tool": "Bash",
      "commandPattern": "ps*"
    },
    {
      "tool": "Glob",
      "pathPattern": "**"
    },
    {
      "tool": "Grep",
      "pathPattern": "**"
    },
    {
      "tool": "BashOutput",
      "commandPattern": "*"
    },
    {
      "tool": "Task",
      "pathPattern": "*"
    },
    {
      "tool": "TodoWrite"
    },
    {
      "tool": "WebFetch",
      "urlPattern": "https://**"
    }
  ],
  "allowedDirectories": [
    "~/dotfiles",
    "~/codebase",
    "~/codebase/basket-service",
    "~/codebase/block-builder-api",
    "~/codebase/block-builder-app",
    "~/codebase/CF-Cypress",
    "~/codebase/experience-decision-engine",
    "~/codebase/homebase",
    "~/codebase/homebase-design-tokens",
    "~/codebase/homebase-docs",
    "~/codebase/php",
    "~/codebase/sf-js-libraries",
    "~/codebase/sf-ui-cart-and-checkout",
    "~/codebase/sf-ui-checkout",
    "~/codebase/sf-ui-web",
    "~/codebase/terraform"
  ],
  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"]
    },
    "glean": {
      "command": "npx",
      "args": ["-y", "@gleanwork/local-mcp-server"],
      "env": {
        "GLEAN_INSTANCE": "wayfair",
        "GLEAN_API_TOKEN": "***REMOVED-SECRET***"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--extension"],
      "env": {}
    }
  }
}
