{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "BashOutput",
      "WebFetch",
      "WebSearch",
      "EnterPlanMode"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/node_modules/**)",
      "Read(**/target/**)",
      "Read(**/.git/**)",
      "Read(**/build/**)",
      "Read(**/dist/**)",
      "Read(**/*.log)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/.cache/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.tox/**)",
      "Read(**/*.pyc)",
      "Read(**/.DS_Store)",
      "Read(**/vendor/**)",
      "Read(**/.gradle/**)",
      "Read(**/.idea/**)",
      "Read(**/.vscode/**)",
      "Read(**/*.map)",
      "Read(**/.terraform/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/composer.lock)",
      "Read(**/.turbo/**)",
      "Read(**/.webpack/**)",
      "Read(**/.parcel-cache/**)",
      "Read(**/.vite/**)",
      "Read(**/.nuxt/**)",
      "Read(**/.output/**)",
      "Read(**/out/**)",
      "Read(**/.yarn/cache/**)",
      "Read(**/.yarn/unplugged/**)",
      "Read(**/.pnpm-store/**)",
      "Read(**/.npm/**)",
      "Read(**/.nyc_output/**)",
      "Read(**/htmlcov/**)",
      "Read(**/test-results/**)",
      "Read(**/*.swp)",
      "Read(**/*.swo)",
      "Read(**/*~)"
    ],
    "ask": [],
    "defaultMode": "default"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/hooks/session/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/hooks/session/session-end.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/scripts/utils/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/scripts/utils/notify.sh"
          },
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/hooks/session/claude-stop.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/hooks/tracking/track-agent.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/hooks/session/user-input.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/hooks/tools/pre-tool-use.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{dotfiles}}/claude/hooks/tools/post-tool-use.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "alwaysThinkingEnabled": false,
  "defaultMode": "plan",
  "allowedTools": [
    {
      "tool": "EnterPlanMode",
      "pathPattern": "**"
    },
    {
      "tool": "Read",
      "pathPattern": "**"
    },
    {
      "tool": "Write",
      "pathPattern": "**"
    },
    {
      "tool": "Edit",
      "pathPattern": "**"
    },
    {
      "tool": "Bash",
      "commandPattern": "ls*"
    },
    {
      "tool": "Bash",
      "commandPattern": "cd*"
    },
    {
      "tool": "Bash",
      "commandPattern": "pwd*"
    },
    {
      "tool": "Bash",
      "commandPattern": "cat*"
    },
    {
      "tool": "Bash",
      "commandPattern": "grep*"
    },
    {
      "tool": "Bash",
      "commandPattern": "echo*"
    },
    {
      "tool": "Bash",
      "commandPattern": "mkdir*"
    },
    {
      "tool": "Bash",
      "commandPattern": "touch*"
    },
    {
      "tool": "Bash",
      "commandPattern": "which*"
    },
    {
      "tool": "Bash",
      "commandPattern": "ps*"
    },
    {
      "tool": "Glob",
      "pathPattern": "**"
    },
    {
      "tool": "Grep",
      "pathPattern": "**"
    },
    {
      "tool": "BashOutput",
      "commandPattern": "*"
    },
    {
      "tool": "Task",
      "pathPattern": "*"
    },
    {
      "tool": "TodoWrite"
    },
    {
      "tool": "WebFetch",
      "urlPattern": "https://**"
    }
  ],
  "allowedDirectories": [
    "{{dotfiles}}",
    "{{codebase}}",
    "{{codebase}}/basket-service",
    "{{codebase}}/block-builder-api",
    "{{codebase}}/block-builder-app",
    "{{codebase}}/CF-Cypress",
    "{{codebase}}/experience-decision-engine",
    "{{codebase}}/homebase",
    "{{codebase}}/homebase-design-tokens",
    "{{codebase}}/homebase-docs",
    "{{codebase}}/php",
    "{{codebase}}/sf-js-libraries",
    "{{codebase}}/sf-ui-cart-and-checkout",
    "{{codebase}}/sf-ui-checkout",
    "{{codebase}}/sf-ui-web",
    "{{codebase}}/terraform"
  ],
  "mcpServers": {}
}
