# Kitty Configuration
# Matching features from alacritty.toml

# Font Configuration
font_family      JetBrainsMono Nerd Font Mono Medium
bold_font        JetBrainsMono Nerd Font Mono Bold
italic_font      JetBrainsMono Nerd Font Mono Italic
font_size 14.0

# Window
initial_window_width  100c
initial_window_height 30c
remember_window_size  yes

# Start maximized (closest to alacritty's startup_mode = "Maximized")
# Note: This requires desktop environment support
# On macOS, use: kitty --start-as=maximized
# Or add to shell alias: alias kitty='kitty --start-as=maximized'

# Window padding
window_padding_width 0

# Window decorations (none = no title bar)
hide_window_decorations titlebar-only
macos_show_window_title_in none

# Background opacity
# background_opacity 0.85

# Cursor
cursor_shape block
cursor_blink_interval 0.5
cursor_stop_blinking_after 15.0
# Bright green for high contrast visibility
# cursor #50fa7b
# cursor_text_color background

# Scrollback
scrollback_lines 10000

# Mouse
mouse_hide_wait 3.0

# Terminal bell - visual notification (green flash like alacritty)
enable_audio_bell no
visual_bell_duration 0.3
# visual_bell_color #44df44

# Shell
shell /bin/zsh --login

# Environment
# Note: kitty sets TERM automatically to xterm-kitty for best compatibility
# You can override if needed: term xterm-256color

# Color scheme - Dracula (overridden by current-theme.conf below)
# include dracula.conf

# Performance
repaint_delay 10
input_delay 3
sync_to_monitor yes

# Tab bar (disabled by default)
tab_bar_style fade
tab_fade 0.25 0.5 0.75 1

# Advanced
allow_remote_control yes
listen_on unix:/tmp/kitty

# Clipboard - OSC 52 support for tmux/remote sessions
clipboard_control write-clipboard write-primary read-clipboard read-primary

# Ligatures - enable for programming fonts
disable_ligatures never

# macOS specific
macos_option_as_alt yes
macos_quit_when_last_window_closed yes

# Keybindings (matching alacritty)
map cmd+n new_os_window
map cmd+equal change_font_size all +2.0
map cmd+plus change_font_size all +2.0
map cmd+minus change_font_size all -2.0
map cmd+0 change_font_size all 0

# Copy/paste
map cmd+c copy_to_clipboard
map cmd+v paste_from_clipboard

# Additional useful keybindings
map cmd+t new_tab
map cmd+w close_tab
map cmd+shift+[ previous_tab
map cmd+shift+] next_tab


# BEGIN_KITTY_THEME
# Gruvbox Material Light Hard
include current-theme.conf
# END_KITTY_THEME