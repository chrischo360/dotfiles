{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{{home}}"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{github_token}}"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_STORE_PATH": "{{dotfiles}}/ai-config/memory"
      }
    },
    "github_wayfair": {
      "command": "docker",
      "args": [
        "run",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "artifactorydocker.service.csnzoo.com/wayfair/github-mcp-server:latest",
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{github_token}}"
      }
    },
    "buildkite": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "BUILDKITE_API_TOKEN",
        "artifactorydocker.service.csnzoo.com/wayfair/buildkite-mcp-server:0.5.0-wf1",
        "stdio"
      ],
      "env": {
        "BUILDKITE_API_TOKEN": "{{buildkite_token}}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--extension"],
      "env": {}
    },
    "glean_default": {
      "url": "https://wayfair-be.glean.com/mcp/default"
    },
    "sourcegraph": {
      "url": "https://wayfair.sourcegraphcloud.com/.api/mcp/v1",
      "headers": {
        "Authorization": "token {{sourcegraph_token}}"
      }
    },
    "storybook": {
      "command": "npx",
      "args": ["-y", "@storybook/mcp"],
      "env": {}
    },
    "graphql_storefront": {
      "url": "http://kube-unified-schema-mcp-server.service.intradsm1.sdeconsul.csnzoo.com/mcp"
    },
    "graphql_service_to_service": {
      "url": "http://kube-unified-schema-mcp-server-service-to-service.service.intradsm1.sdeconsul.csnzoo.com/mcp"
    },
    "graphql_partner": {
      "url": "http://kube-unified-schema-mcp-server-partner.service.intradsm1.sdeconsul.csnzoo.com/mcp"
    },
    "graphql_internal": {
      "url": "http://kube-unified-schema-mcp-server-internal.service.intradsm1.sdeconsul.csnzoo.com/mcp"
    }
  }
}
