{
  "settings": {
    "notifications": true,
    "notify_on": ["success", "failure"],
    "sound": "default",
    "log_dir": "~/.dev/logs"
  },
  "global_scripts": {
    "diagnose": {
      "steps": [
        { "shell": "echo '🔍 Diagnosing failure in $PROJECT_NAME...'" },
        { "shell": "echo 'Script: $SCRIPT_NAME | Step: $FAILED_STEP'" },
        { "shell": "echo 'Log file: $LOG_FILE'" },
        { "shell": "echo ''" },
        { "shell": "echo 'Last 30 lines of error:' && tail -30 \"$LOG_FILE\"" },
        { "shell": "echo ''" },
        { "shell": "echo 'Starting AI diagnosis...' && cli-agent \"Diagnose and fix this build failure. Project: $PROJECT_NAME. Script: $SCRIPT_NAME. Failed step: $FAILED_STEP. Read the log file at $LOG_FILE for full output.\"" }
      ],
      "notify": false
    }
  },
  "projects": {
    "sf-ui-web": {
      "detect": [
        { "package_name": "sf-ui-web" },
        { "git_remote": "sf-ui-web" },
        { "path_contains": "sf-ui-web" }
      ],
      "scripts": {
        "setup": [
          "install",
          "codegen",
          "build",
          { "context": "apps/core-funnel", "run": "start" }
        ],
        "fullreset": [
          "clean -a",
          "install",
          "codegen",
          "build"
        ],
        "dev:web": [
          { "context": "apps/core-funnel", "run": "start" }
        ],
        "dev:plat": [
          { "context": "apps/platform-capabilities", "run": "start" }
        ],
        "dev:layout": [
          { "context": "apps/sf-ui-layout", "run": "start" }
        ],
        "quick": [
          "codegen",
          "build"
        ],
        "pr:check": {
          "steps": [
            "format",
            "lint",
            "typecheck",
            "build",
            "test"
          ],
          "notify": true,
          "on_failure": { "shell": "echo 'PR check failed at step: $FAILED_STEP' && echo 'Error: $FAILED_ERROR'" }
        },
        "pr:submit": {
          "steps": [
            "format",
            "lint", 
            "typecheck",
            "build",
            "test",
            { "shell": "PR_URL=$(gh pr view --json url -q '.url' 2>/dev/null); [ -z \"$PR_URL\" ] && echo '⚠️ No PR found, skipping watch.' && exit 0; scout watch-builds \"$PR_URL\"" }
          ],
          "notify": true,
          "on_failure": { "script": "diagnose" }
        },
        "pr:watch": [
          { "shell": "PR_URL=$(gh pr view --json url -q '.url' 2>/dev/null) && [ -n \"$PR_URL\" ] && scout watch-builds \"$PR_URL\" || echo '❌ No PR found for current branch. Create a PR first with: gh pr create'" }
        ],
        "pr:autofix": {
          "description": "Watch PR, auto-diagnose and fix on failure, merge on success",
          "steps": [
            { "shell": "echo '🔄 Starting PR watch loop...'" },
            { "shell": "PR_URL=$(gh pr view --json url -q '.url' 2>/dev/null); [ -z \"$PR_URL\" ] && echo '❌ No PR found. Create one first.' && exit 1; scout watch-builds \"$PR_URL\"" }
          ],
          "on_success": { "shell": "echo '✅ All checks passed!' && terminal-notifier -title 'PR Ready' -message 'All checks passed! Ready to merge.' -sound default" },
          "on_failure": { "script": "diagnose" },
          "loop": {
            "enabled": true,
            "max_retries": 3,
            "retry_delay": 10,
            "retry_on": "failure"
          }
        },
        "pr:automerge": {
          "description": "Watch PR checks, auto-merge when passing",
          "steps": [
            { "shell": "PR_URL=$(gh pr view --json url -q '.url' 2>/dev/null); [ -z \"$PR_URL\" ] && echo '❌ No PR found. Create one first.' && exit 1; scout watch-builds \"$PR_URL\"" }
          ],
          "on_success": { "shell": "echo '✅ Merging PR...' && gh pr merge --auto --squash" },
          "notify": true
        },
        "format:check": [
          { "shell": "yarn format:check" }
        ]
      },
      "contexts": {
        "/": {
          "build": "yarn lib:build",
          "build:all": "yarn build",
          "codegen": "yarn gql:codegen",
          "lint": "yarn lint",
          "format": "yarn format",
          "test": "yarn test",
          "typecheck": "yarn type-check",
          "translate": "yarn translate",
          "install": "yarn install",
          "rebuild": "yarn gql:codegen && yarn lib:build",
          "clean": "find . -name dist -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; find . -name .next -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null",
          "clean:dist": "find . -name dist -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; find . -name .next -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null",
          "clean:turbo": "rm -rf .turbo",
          "clean:generated": "find . -name '*.generated.ts' -not -path '*/node_modules/*' -delete",
          "clean:node": "rm -rf node_modules && yarn install",
          "clean:all": "find . -name dist -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; find . -name .next -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; rm -rf .turbo; find . -name '*.generated.ts' -not -path '*/node_modules/*' -delete",
          "clean -t": "rm -rf .turbo",
          "clean -g": "find . -name '*.generated.ts' -not -path '*/node_modules/*' -delete",
          "clean -n": "rm -rf node_modules && yarn install",
          "clean -a": "find . -name dist -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; find . -name .next -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; rm -rf .turbo; find . -name '*.generated.ts' -not -path '*/node_modules/*' -delete",
          "reset": "yarn install && yarn gql:codegen && yarn lib:build"
        },
        "apps/core-funnel": {
          "start": "yarn dev",
          "build": "yarn build",
          "test": "yarn test",
          "lint": "yarn lint",
          "format": "yarn format",
          "typecheck": "yarn type-check",
          "playwright": "yarn playwright:smoke",
          "playwright:ui": "yarn playwright:dev"
        },
        "apps/platform-capabilities": {
          "start": "yarn dev",
          "build": "yarn build",
          "test": "yarn test",
          "lint": "yarn lint",
          "format": "yarn format",
          "cypress": "yarn cypress"
        },
        "apps/sf-ui-layout": {
          "start": "yarn dev",
          "build": "yarn build",
          "test": "yarn test",
          "lint": "yarn lint",
          "format": "yarn format",
          "typecheck": "yarn type-check",
          "cypress": "yarn cypress"
        },
        "apps/*": {
          "start": "yarn dev",
          "build": "yarn build",
          "test": "yarn test",
          "lint": "yarn lint",
          "format": "yarn format"
        },
        "libs/*": {
          "start": "yarn dev",
          "build": "yarn build",
          "test": "yarn test",
          "lint": "yarn lint",
          "format": "yarn format",
          "typecheck": "yarn type-check",
          "storybook": "yarn storybook"
        },
        "tools/*": {
          "build": "yarn build",
          "test": "yarn test",
          "lint": "yarn lint",
          "format": "yarn format"
        }
      }
    },
    "scout": {
      "detect": [
        { "package_name": "scout" },
        { "path_contains": "scout" }
      ],
      "contexts": {
        "/": {
          "start": "npm run dev",
          "build": "npm run build",
          "test": "npm test",
          "clean": "rm -rf dist node_modules"
        }
      }
    }
  },
  "defaults": {
    "nextjs": {
      "detect": [
        { "file": "next.config.js" },
        { "file": "next.config.mjs" },
        { "file": "next.config.ts" }
      ],
      "commands": {
        "start": "npm run dev",
        "build": "npm run build",
        "clean": "rm -rf .next dist",
        "lint": "npm run lint"
      }
    },
    "node": {
      "detect": [
        { "file": "package.json" }
      ],
      "commands": {
        "start": "npm run dev",
        "build": "npm run build",
        "test": "npm test",
        "clean": "rm -rf node_modules dist",
        "install": "npm install"
      }
    },
    "python": {
      "detect": [
        { "file": "pyproject.toml" },
        { "file": "requirements.txt" }
      ],
      "commands": {
        "start": "python -m uvicorn main:app --reload",
        "test": "pytest",
        "clean": "rm -rf __pycache__ .pytest_cache dist .venv",
        "install": "pip install -r requirements.txt"
      }
    }
  }
}
