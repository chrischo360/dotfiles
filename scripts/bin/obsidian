#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  exec open -a "Obsidian"
fi

for target in "$@"; do
  if [[ "$target" == obsidian://* ]]; then
    open "$target"
    continue
  fi

  url=$(python3 -c 'import pathlib, sys, urllib.parse; print("obsidian://open?path=" + urllib.parse.quote(str(pathlib.Path(sys.argv[1]).expanduser().resolve())))' "$target")
  open "$url"
done
