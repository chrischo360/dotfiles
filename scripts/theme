#!/bin/bash
# Unified theme switcher for Ghostty + Neovim

DOTFILES_DIR="$HOME/dotfiles"
GHOSTTY_CONFIG="$DOTFILES_DIR/ghostty/config"
MODE_FILE="$HOME/.config/theme-mode"
ACTIVE_THEME_FILE="$HOME/.config/active-theme"

get_mode() {
    cat "$MODE_FILE" 2>/dev/null || echo "dark"
}

get_active() {
    cat "$ACTIVE_THEME_FILE" 2>/dev/null || echo "dracula"
}

show_current() {
    ghostty_theme=$(grep "^theme = " "$GHOSTTY_CONFIG" | sed 's/theme = //')
    echo "Ghostty: ${ghostty_theme:-unknown}"
    echo "Neovim:  $(get_active)"
    echo "Mode:    $(get_mode)"
}

print_usage() {
    echo "Usage: theme <name> [dark|light]"
    echo ""
    echo "Available themes:"
    echo "  dracula     - Purple/pink dark theme"
    echo "  onedark     - Atom-inspired theme (dark/light)"
    echo "  rose-pine   - Elegant light theme (dawn)"
    echo "  papercolor  - Clean high-contrast theme (dark/light)"
    echo "  github-dark - GitHub theme (dark/light)"
    echo "  catppuccin  - Pastel theme, frappe (dark) / latte (light)"
    echo "  gruvbox     - Retro earthy yellows/oranges (dark/light)"
    echo "  nightfox    - Muted blues dark (use 'light' for dayfox)"
    echo "  carbonfox   - Carbon-toned dark (nightfox family)"
    echo "  duskfox     - Warm dusk dark (nightfox family)"
    echo "  everforest  - Natural green palette (dark/light)"
    echo "  solarized   - Classic solarized (dark/light)"
    echo "  custom      - Your custom theme (dark/light)"
}

resolve_theme() {
    local theme=$1
    local mode=${2:-dark}
    local ghostty_theme
    local nvim_theme="$theme"

    case "$theme" in
        dracula)
            if [ "$mode" = "light" ]; then
                echo "dracula: no light variant, using dark" >&2
                mode="dark"
            fi
            ghostty_theme="Dracula"
            ;;
        onedark)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Atom One Light"
            else
                ghostty_theme="Atom One Dark"
            fi
            ;;
        rose-pine)
            ghostty_theme="Rose Pine Dawn"
            mode="light"
            ;;
        papercolor)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Pencil Light"
            else
                ghostty_theme="Pencil Dark"
            fi
            ;;
        github-dark)
            if [ "$mode" = "light" ]; then
                ghostty_theme="GitHub Light Default"
            else
                ghostty_theme="GitHub Dark Dimmed"
            fi
            ;;
        catppuccin)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Catppuccin Latte"
            else
                ghostty_theme="Catppuccin Frappe"
            fi
            ;;
        gruvbox)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Gruvbox Light"
            else
                ghostty_theme="Gruvbox Dark Hard"
            fi
            ;;
        nightfox)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Dayfox"
                nvim_theme="nightfox"
            else
                ghostty_theme="Nightfox"
            fi
            ;;
        carbonfox)
            ghostty_theme="Carbonfox"
            mode="dark"
            ;;
        duskfox)
            ghostty_theme="Duskfox"
            mode="dark"
            ;;
        everforest)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Everforest Light Med"
            else
                ghostty_theme="Everforest Dark Hard"
            fi
            ;;
        solarized)
            if [ "$mode" = "light" ]; then
                ghostty_theme="iTerm2 Solarized Light"
            else
                ghostty_theme="iTerm2 Solarized Dark"
            fi
            ;;
        custom)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Gruvbox Light"
            else
                ghostty_theme="Gruvbox Dark Hard"
            fi
            ;;
        *)
            echo "Unknown theme: $theme" >&2
            echo "" >&2
            print_usage >&2
            return 1
            ;;
    esac

    printf '%s|%s|%s\n' "$ghostty_theme" "$nvim_theme" "$mode"
}

preview_theme() {
    local theme=$1
    local mode=${2:-dark}
    local desc=$3
    local resolved ghostty_theme nvim_theme

    resolved=$(resolve_theme "$theme" "$mode" 2>/dev/null) || exit 0
    ghostty_theme=$(echo "$resolved" | cut -d'|' -f1)
    nvim_theme=$(echo "$resolved" | cut -d'|' -f2)
    mode=$(echo "$resolved" | cut -d'|' -f3)

    printf 'Theme:   %s\n' "$theme"
    printf 'Mode:    %s\n' "$mode"
    printf 'Ghostty: %s\n' "$ghostty_theme"
    printf 'Neovim:  %s\n\n' "$nvim_theme"
    [ -n "$desc" ] && printf '%s\n\n' "$desc"

    printf 'ANSI sample:\n\n'
    printf '\033[30mBlack\033[0m   \033[37mWhite\033[0m   \033[90mBright black\033[0m\n'
    printf '\033[31mRed\033[0m     \033[32mGreen\033[0m   \033[33mYellow\033[0m\n'
    printf '\033[34mBlue\033[0m    \033[35mMagenta\033[0m \033[36mCyan\033[0m\n\n'
    printf '\033[40m  \033[0m \033[41m  \033[0m \033[42m  \033[0m \033[43m  \033[0m \033[44m  \033[0m \033[45m  \033[0m \033[46m  \033[0m \033[47m  \033[0m\n'
}

switch_theme() {
    local theme=$1
    local mode=${2:-dark}
    local resolved ghostty_theme nvim_theme

    resolved=$(resolve_theme "$theme" "$mode") || return 1
    ghostty_theme=$(echo "$resolved" | cut -d'|' -f1)
    nvim_theme=$(echo "$resolved" | cut -d'|' -f2)
    mode=$(echo "$resolved" | cut -d'|' -f3)

    # Save state
    echo "$mode" > "$MODE_FILE"
    echo "$nvim_theme" > "$ACTIVE_THEME_FILE"

    # --- Ghostty ---
    sed -i '' "s/^theme = .*/theme = $ghostty_theme/" "$GHOSTTY_CONFIG"
    echo "Ghostty: $ghostty_theme"

    # Reload Ghostty config across all windows (simulate Cmd+Shift+,)
    osascript \
        -e 'tell application "Ghostty" to activate' \
        -e 'tell application "System Events" to keystroke "," using {command down, shift down}' \
        2>/dev/null && echo "Ghostty: reloaded all windows"

    # --- Neovim live reload (parallel, 3s timeout) ---
    echo "Neovim:  $nvim_theme ($mode)"
    sockets=$(lsof -U -a -c nvim 2>/dev/null | awk '/nvim\.[0-9]+/ {print $NF}' | sort -u)
    tmp_dir=$(mktemp -d)
    pids=()
    for socket in $sockets; do
        (
            result=$(nvim --server "$socket" --remote-expr "v:lua.require('config.theme').switch('$nvim_theme', '$mode')" </dev/null 2>/dev/null)
            [ "$result" = "ok" ] && echo "ok" >> "$tmp_dir/results"
            [ -n "$result" ] && [ "$result" != "ok" ] && \
              case "$result" in *"unknown theme"*) ;; *) echo "warn: $result" >> "$tmp_dir/results" ;; esac
        ) &
        pids+=($!)
    done
    # Kill stragglers after 3s, then collect results
    ( sleep 3; for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null; done ) &
    killer=$!
    wait "${pids[@]}" 2>/dev/null
    kill "$killer" 2>/dev/null
    reloaded=$(grep -c "^ok$" "$tmp_dir/results" 2>/dev/null || echo 0)
    grep "^warn:" "$tmp_dir/results" 2>/dev/null | while read -r line; do echo "Neovim:  $line"; done
    rm -rf "$tmp_dir"
    [ "$reloaded" -gt 0 ] && echo "Neovim:  reloaded $reloaded instance(s) live"
}

pick_theme() {
    local current_mode
    current_mode=$(get_mode)

    # Step 1: pick mode
    local mode
    mode=$(printf '%s\n' "dark" "light" \
        | fzf --header "Current: $(get_active) ($current_mode)" \
              --prompt "Mode > " \
              --height 20% --reverse)
    [ -z "$mode" ] && return

    # Step 2: show themes for that mode
    local themes
    if [ "$mode" = "dark" ]; then
        themes=$(printf '%s\n' \
            "dracula|Purple/pink dark theme" \
            "onedark|Atom-inspired dark theme" \
            "papercolor|Clean high-contrast dark theme" \
            "github-dark|GitHub Dark Dimmed" \
            "catppuccin|Pastel dark theme (frappe)" \
            "gruvbox|Retro earthy yellows/oranges" \
            "nightfox|Muted navy blues" \
            "carbonfox|Carbon-toned dark (nightfox family)" \
            "duskfox|Warm dusk dark (nightfox family)" \
            "everforest|Natural green palette" \
            "solarized|Classic solarized dark" \
            "custom|Your custom dark theme")
    else
        themes=$(printf '%s\n' \
            "onedark|Atom-inspired light theme" \
            "rose-pine|Elegant light theme (dawn)" \
            "papercolor|Clean high-contrast light theme" \
            "github-dark|GitHub Light" \
            "catppuccin|Pastel light theme (latte)" \
            "gruvbox|Retro earthy warm tones" \
            "nightfox|Dayfox clean professional light" \
            "everforest|Natural green palette light" \
            "solarized|Classic solarized light" \
            "custom|Your custom light theme")
    fi

    local selection
    selection=$(printf '%s\n' "$themes" \
        | fzf --delimiter='|' \
              --with-nth=1,2 \
              --header "Select $mode theme" \
              --prompt "Theme > " \
              --height 50% --reverse \
              --preview "$0 --preview {1} $mode {2}" \
              --preview-window=right:55% \
        | cut -d'|' -f1)

    [ -n "$selection" ] && switch_theme "$selection" "$mode"
}

if [ "$1" = "--preview" ]; then
    preview_theme "$2" "$3" "$4"
    exit 0
fi

if [ $# -eq 0 ]; then
    if command -v fzf &>/dev/null; then
        pick_theme
    else
        show_current
    fi
else
    switch_theme "$1" "${2:-dark}"
fi
