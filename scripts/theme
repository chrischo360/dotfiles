#!/bin/bash
# Unified theme switcher for Ghostty + Neovim

DOTFILES_DIR="$HOME/dotfiles"
GHOSTTY_CONFIG="$DOTFILES_DIR/ghostty/config"
MODE_FILE="$HOME/.config/theme-mode"
ACTIVE_THEME_FILE="$HOME/.config/active-theme"

get_mode() {
    cat "$MODE_FILE" 2>/dev/null || echo "dark"
}

get_active() {
    cat "$ACTIVE_THEME_FILE" 2>/dev/null || echo "dracula"
}

show_current() {
    ghostty_theme=$(grep "^theme = " "$GHOSTTY_CONFIG" | sed 's/theme = //')
    echo "Ghostty: ${ghostty_theme:-unknown}"
    echo "Neovim:  $(get_active)"
    echo "Mode:    $(get_mode)"
}

switch_theme() {
    local theme=$1
    local mode=${2:-dark}
    local ghostty_theme
    local nvim_theme="$theme"

    case "$theme" in
        dracula)
            if [ "$mode" = "light" ]; then
                echo "dracula: no light variant, using dark"
                mode="dark"
            fi
            ghostty_theme="Dracula"
            ;;
        onedark)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Atom One Light"
            else
                ghostty_theme="Atom One Dark"
            fi
            ;;
        rose-pine)
            ghostty_theme="Rose Pine Dawn"
            mode="light"
            ;;
        papercolor)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Pencil Light"
            else
                ghostty_theme="Pencil Dark"
            fi
            ;;
        github-dark)
            if [ "$mode" = "light" ]; then
                ghostty_theme="GitHub Light Default"
            else
                ghostty_theme="GitHub Dark Dimmed"
            fi
            ;;
        catppuccin)
            if [ "$mode" = "light" ]; then
                ghostty_theme="Catppuccin Latte"
            else
                ghostty_theme="Catppuccin Frappe"
            fi
            ;;
        *)
            echo "Unknown theme: $theme"
            echo ""
            echo "Usage: theme <name> [dark|light]"
            echo ""
            echo "Available themes:"
            echo "  dracula     - Purple/pink dark theme"
            echo "  onedark     - Atom-inspired theme (dark/light)"
            echo "  rose-pine   - Elegant light theme (dawn)"
            echo "  papercolor  - Clean high-contrast theme (dark/light)"
            echo "  github-dark - GitHub theme (dark/light)"
            echo "  catppuccin  - Pastel theme, frappe (dark) / latte (light)"
            return 1
            ;;
    esac

    # Save state
    echo "$mode" > "$MODE_FILE"
    echo "$nvim_theme" > "$ACTIVE_THEME_FILE"

    # --- Ghostty ---
    sed -i '' "s/^theme = .*/theme = $ghostty_theme/" "$GHOSTTY_CONFIG"
    echo "Ghostty: $ghostty_theme"

    # Reload Ghostty config across all windows (simulate Cmd+Shift+,)
    osascript \
        -e 'tell application "Ghostty" to activate' \
        -e 'tell application "System Events" to keystroke "," using {command down, shift down}' \
        2>/dev/null && echo "Ghostty: reloaded all windows"

    # --- Neovim live reload ---
    echo "Neovim:  $theme ($mode)"
    sockets=$(find /tmp /var/folders -name 'nvim.*' -type s 2>/dev/null)
    if [ -n "$XDG_RUNTIME_DIR" ]; then
        sockets="$sockets $(find "$XDG_RUNTIME_DIR" -name 'nvim.*' -type s 2>/dev/null)"
    fi
    reloaded=0
    for socket in $sockets; do
        result=$(nvim --server "$socket" --remote-expr "v:lua.require('config.theme').switch('$theme', '$mode')" </dev/null 2>/dev/null)
        if [ "$result" = "ok" ]; then
            reloaded=$((reloaded + 1))
        elif [ -n "$result" ]; then
            echo "Neovim:  warning: $result"
        fi
    done
    [ "$reloaded" -gt 0 ] && echo "Neovim:  reloaded $reloaded instance(s) live"
}

pick_theme() {
    local current_mode
    current_mode=$(get_mode)

    # Step 1: pick mode
    local mode
    mode=$(printf '%s\n' "dark" "light" \
        | fzf --header "Current: $(get_active) ($current_mode)" \
              --prompt "Mode > " \
              --height 20% --reverse)
    [ -z "$mode" ] && return

    # Step 2: show themes for that mode
    local themes
    if [ "$mode" = "dark" ]; then
        themes=$(printf '%s\n' \
            "dracula|Purple/pink dark theme" \
            "onedark|Atom-inspired dark theme" \
            "papercolor|Clean high-contrast dark theme" \
            "github-dark|GitHub Dark Dimmed" \
            "catppuccin|Pastel dark theme (frappe)")
    else
        themes=$(printf '%s\n' \
            "onedark|Atom-inspired light theme" \
            "rose-pine|Elegant light theme (dawn)" \
            "papercolor|Clean high-contrast light theme" \
            "github-dark|GitHub Light" \
            "catppuccin|Pastel light theme (latte)")
    fi

    local selection
    selection=$(printf '%s\n' "$themes" \
        | column -t -s'|' \
        | fzf --header "Select $mode theme" \
              --prompt "Theme > " \
              --height 30% --reverse \
        | awk '{print $1}')

    [ -n "$selection" ] && switch_theme "$selection" "$mode"
}

if [ $# -eq 0 ]; then
    if command -v fzf &>/dev/null; then
        pick_theme
    else
        show_current
    fi
else
    switch_theme "$1" "${2:-dark}"
fi
