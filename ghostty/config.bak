# Ghostty Configuration
# Matching features from kitty.conf

# Font Configuration
font-family = SauceCodePro Nerd Font Mono
font-style = SemiBold
font-style-bold = SemiBold
font-style-italic = SemiBold Italic
font-style-bold-italic = SemiBold Italic
font-size = 14

# Window Configuration
window-width = 100
window-height = 30
window-save-state = always
window-decoration = false
window-padding-x = 0
window-padding-y = 0

# macOS-specific window behavior
macos-option-as-alt = true
macos-titlebar-style = hidden

# Shell Integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title
command = /bin/zsh --login

# Terminal Identification
# Ghostty sets TERM=xterm-ghostty automatically
# This provides the best compatibility with Ghostty's features

# Clipboard Support (OSC 52)
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
clipboard-paste-bracketed-safe = true

# Color Support
# Ghostty supports true color (24-bit RGB) by default

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Performance
# Ghostty is GPU-accelerated by default
# Note: Bell settings not exposed in Ghostty config

# Theme: GitHub Dark Dimmed (matching Kitty)
# Ghostty theme format - inline color definitions
background = 22272e
foreground = adbac7
selection-background = 539bf5
selection-foreground = 22272e

# Cursor colors
cursor-color = 539bf5
cursor-text = 22272e

# Normal colors
palette = 0=#545d68
palette = 1=#f47067
palette = 2=#57ab5a
palette = 3=#c69026
palette = 4=#539bf5
palette = 5=#b083f0
palette = 6=#39c5cf
palette = 7=#909dab

# Bright colors
palette = 8=#636e7b
palette = 9=#ff938a
palette = 10=#6bc46d
palette = 11=#daaa3f
palette = 12=#6cb6ff
palette = 13=#dcbdfb
palette = 14=#56d4dd
palette = 15=#cdd9e5

# Keybindings (macOS-style)
keybind = cmd+n=new_window
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+bracket_left=previous_tab
keybind = cmd+shift+bracket_right=next_tab
keybind = cmd+equal=increase_font_size:2
keybind = cmd+plus=increase_font_size:2
keybind = cmd+minus=decrease_font_size:2
keybind = cmd+0=reset_font_size
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Quit when last window closed (macOS behavior)
quit-after-last-window-closed = true

# Disable automatic update checks
auto-update = off
